<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Trabajador</title>
</head>
<body>
    <h1>Editar Trabajador</h1>
    <form action="/trabajador/<%= trabajador._id %>?_method=PUT" method="POST">
        <label>Nombre: <input type="text" name="nombre" value="<%= trabajador.nombre %>" required></label><br>
        <label>Apellido: <input type="text" name="apellido" value="<%= trabajador.apellido %>" required></label><br>
        <label>Cédula de Identidad: <input type="text" name="cedula_identidad" value="<%= trabajador.cedula_identidad %>" required></label><br>
        <label>Cargo: <input type="text" name="cargo" value="<%= trabajador.cargo %>" required></label><br>
        <label>Departamento: <input type="text" name="departamento" value="<%= trabajador.departamento %>" required></label><br>
        <label>Fecha de Ingreso: <input type="date" name="fecha_ingreso" value="<%= trabajador.fecha_ingreso.toISOString().split('T')[0] %>" required></label><br>
        <button type="submit">Actualizar</button>
    </form>
    <a href="/trabajador">Regresar</a>
</body>
</html>
